# Server-side proxy target. Browser requests stay on the frontend origin at
# /api/v1, allowing refresh and CSRF cookies to remain first-party. Set this to
# the public backend origin without a trailing /api/v1 path.
BACKEND_API_URL=http://localhost:4000

# Backward-compatible build-time fallback for existing deployments. New
# deployments should use BACKEND_API_URL instead.
NEXT_PUBLIC_API_URL=http://localhost:4000
